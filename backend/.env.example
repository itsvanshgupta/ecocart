# EcoCart Backend Configuration
# 100% free stack - no credit card needed for any service below.

# Google Gemini API key (free at https://aistudio.google.com) - primary LLM + embeddings
GEMINI_API_KEY=

# Groq API key (free at https://console.groq.com, no card) - optional second LLM
# used automatically when Gemini's free quota is exhausted
GROQ_API_KEY=

# Supabase credentials (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
